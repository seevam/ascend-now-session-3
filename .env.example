# Ascend Now Session 3 - Environment Variables Example
# Copy this file to .env.local for local development

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_DISC_EXPLORER=true
NEXT_PUBLIC_ENABLE_CAREER_MATCHER=true

# TypeFinder Integration (optional - for future use)
# NEXT_PUBLIC_TYPEFINDER_API_KEY=your_api_key_here

# Analytics (optional - for future use)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_id_here
